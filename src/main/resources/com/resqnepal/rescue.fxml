<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="768.0" prefWidth="804.0" spacing="20.0" style="-fx-background-color: #f4f6f7;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.resqnepal.controller.RescueController">
   <padding>
      <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
   </padding>
   <children>
      <Label text="Rescue Requests Management" textFill="#2c3e50">
         <font>
            <Font name="System Bold" size="24.0" />
         </font>
      </Label>
      <VBox spacing="10.0" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 5; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 5, 0, 0, 0);">
         <children>
            <Label text="Register New Request" textFill="#34495e">
               <font>
                  <Font name="System Bold" size="16.0" />
               </font>
            </Label>
            <HBox spacing="15.0">
               <children>
                  <TextField fx:id="victimNameField" promptText="Victim Name" HBox.hgrow="ALWAYS" />
                  <TextField fx:id="victimAgeField" prefWidth="70.0" promptText="Age" />
                  <TextField fx:id="victimPhoneField" promptText="Phone" HBox.hgrow="ALWAYS" />
               </children>
            </HBox>
            <HBox spacing="15.0">
               <children>
                  <TextField fx:id="locXField" prefWidth="100.0" promptText="Location X" />
                  <TextField fx:id="locYField" prefWidth="100.0" promptText="Location Y" />
                  <TextField fx:id="emergencyTypeField" promptText="Emergency Type (e.g. Flood)" HBox.hgrow="ALWAYS" />
               </children>
            </HBox>
            <HBox spacing="15.0">
               <children>
                  <TextField fx:id="peopleAffectedField" prefWidth="120.0" promptText="People Affected" />
                  <ComboBox fx:id="severityComboBox" prefWidth="150.0" promptText="Severity" />
                  <TextField fx:id="specializationField" promptText="Required Specialization" HBox.hgrow="ALWAYS" />
               </children>
            </HBox>
            <TextField fx:id="descriptionField" promptText="Description of the emergency" />
            <HBox alignment="CENTER_RIGHT" spacing="10.0">
               <children>
                  <Button mnemonicParsing="false" onAction="#registerRequest" style="-fx-background-color: #27ae60; -fx-text-fill: white;" text="Register Request">
                     <font>
                        <Font size="14.0" />
                     </font>
                  </Button>
               </children>
               <VBox.margin>
                  <Insets top="10.0" />
               </VBox.margin>
            </HBox>
         </children>
      </VBox>
      <HBox alignment="CENTER_LEFT" spacing="15.0">
         <children>
            <Label text="Request Queue" textFill="#34495e">
               <font>
                  <Font name="System Bold" size="16.0" />
               </font>
            </Label>
            <Button mnemonicParsing="false" onAction="#processNextRequest" style="-fx-background-color: #e67e22; -fx-text-fill: white;" text="Process Next Request" />
            <Button mnemonicParsing="false" onAction="#refreshTable" style="-fx-background-color: #3498db; -fx-text-fill: white;" text="Refresh" />
         </children>
      </HBox>
      <TableView fx:id="requestTable" prefHeight="350.0" prefWidth="200.0" VBox.vgrow="ALWAYS">
        <columns>
          <TableColumn fx:id="idCol" prefWidth="90.0" text="Request ID" />
          <TableColumn fx:id="victimCol" prefWidth="70.0" text="Victim ID" />
            <TableColumn fx:id="typeCol" prefWidth="100.0" text="Type" />
            <TableColumn fx:id="severityCol" prefWidth="80.0" text="Severity" />
            <TableColumn fx:id="peopleCol" prefWidth="90.0" text="People Aff." />
            <TableColumn fx:id="specCol" prefWidth="120.0" text="Specialization" />
            <TableColumn fx:id="statusCol" prefWidth="90.0" text="Status" />
            <TableColumn fx:id="descCol" prefWidth="150.0" text="Description" />
        </columns>
      </TableView>
   </children>
</VBox>
