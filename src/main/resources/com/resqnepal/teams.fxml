<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="768.0" prefWidth="804.0" spacing="20.0" style="-fx-background-color: #f4f6f7;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.resqnepal.controller.TeamController">
   <padding>
      <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
   </padding>
   <children>
      <Label text="Rescue Teams Management" textFill="#2c3e50">
         <font>
            <Font name="System Bold" size="24.0" />
         </font>
      </Label>
      <VBox spacing="10.0" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 5; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 5, 0, 0, 0);">
         <children>
            <Label text="Team Information" textFill="#34495e">
               <font>
                  <Font name="System Bold" size="16.0" />
               </font>
            </Label>
            <HBox spacing="15.0">
               <children>
                  <TextField fx:id="teamNameField" promptText="Team Name" HBox.hgrow="ALWAYS" />
                  <TextField fx:id="specializationField" promptText="Specialization" HBox.hgrow="ALWAYS" />
                  <TextField fx:id="membersField" prefWidth="100.0" promptText="Members" />
               </children>
            </HBox>
            <HBox spacing="15.0">
               <children>
                  <TextField fx:id="locXField" prefWidth="100.0" promptText="Location X" />
                  <TextField fx:id="locYField" prefWidth="100.0" promptText="Location Y" />
                  <ComboBox fx:id="statusComboBox" prefWidth="150.0" promptText="Status" />
               </children>
            </HBox>
            <HBox spacing="10.0">
               <children>
                  <Button mnemonicParsing="false" onAction="#addTeam" style="-fx-background-color: #27ae60; -fx-text-fill: white;" text="Add Team" />
                  <Button mnemonicParsing="false" onAction="#updateTeam" style="-fx-background-color: #f39c12; -fx-text-fill: white;" text="Update Team" />
                  <Button mnemonicParsing="false" onAction="#changeStatus" style="-fx-background-color: #8e44ad; -fx-text-fill: white;" text="Change Status Only" />
               </children>
               <VBox.margin>
                  <Insets top="10.0" />
               </VBox.margin>
            </HBox>
         </children>
      </VBox>
      <HBox alignment="CENTER_LEFT" spacing="15.0">
         <children>
            <Label text="Teams List" textFill="#34495e">
               <font>
                  <Font name="System Bold" size="16.0" />
               </font>
            </Label>
            <Button mnemonicParsing="false" onAction="#refreshTable" style="-fx-background-color: #3498db; -fx-text-fill: white;" text="Refresh List" />
         </children>
      </HBox>
      <TableView fx:id="teamTable" prefHeight="350.0" prefWidth="200.0" VBox.vgrow="ALWAYS">
        <columns>
          <TableColumn fx:id="idCol" prefWidth="90.0" text="Team ID" />
          <TableColumn fx:id="nameCol" prefWidth="150.0" text="Team Name" />
            <TableColumn fx:id="specCol" prefWidth="150.0" text="Specialization" />
            <TableColumn fx:id="memberCol" prefWidth="90.0" text="Members" />
            <TableColumn fx:id="locXCol" prefWidth="70.0" text="Loc X" />
            <TableColumn fx:id="locYCol" prefWidth="70.0" text="Loc Y" />
            <TableColumn fx:id="statusCol" prefWidth="100.0" text="Status" />
        </columns>
      </TableView>
   </children>
</VBox>
