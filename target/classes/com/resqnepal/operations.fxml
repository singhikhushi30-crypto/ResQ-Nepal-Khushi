<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="768.0" prefWidth="804.0" spacing="20.0" style="-fx-background-color: #f4f6f7;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.resqnepal.controller.OperationController">
   <padding>
      <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
   </padding>
   <children>
      <Label text="Rescue Operations" textFill="#2c3e50">
         <font>
            <Font name="System Bold" size="24.0" />
         </font>
      </Label>
      <HBox alignment="CENTER_LEFT" spacing="15.0">
         <children>
            <Label text="Operation History" textFill="#34495e">
               <font>
                  <Font name="System Bold" size="16.0" />
               </font>
            </Label>
            <Button mnemonicParsing="false" onAction="#refreshTable" style="-fx-background-color: #3498db; -fx-text-fill: white;" text="Refresh List" />
         </children>
      </HBox>
      <TableView fx:id="operationTable" prefHeight="350.0" prefWidth="200.0" VBox.vgrow="ALWAYS">
        <columns>
          <TableColumn fx:id="opIdCol" prefWidth="150.0" text="Operation ID" />
          <TableColumn fx:id="reqIdCol" prefWidth="150.0" text="Request ID" />
            <TableColumn fx:id="teamIdCol" prefWidth="120.0" text="Team ID" />
            <TableColumn fx:id="startCol" prefWidth="150.0" text="Start Time" />
            <TableColumn fx:id="endCol" prefWidth="150.0" text="End Time" />
            <TableColumn fx:id="statusCol" prefWidth="100.0" text="Status" />
        </columns>
      </TableView>
   </children>
</VBox>
