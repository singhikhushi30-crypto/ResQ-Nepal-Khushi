<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="768.0" prefWidth="804.0" spacing="20.0" style="-fx-background-color: #f4f6f7;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.resqnepal.controller.CaseStudyController">
   <padding>
      <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
   </padding>
   <children>
      <Label text="NEPAL FLOOD RESPONSE SIMULATION" textFill="#2c3e50">
         <font>
            <Font name="System Bold" size="24.0" />
         </font>
      </Label>
      <VBox alignment="CENTER" style="-fx-background-color: #f1c40f; -fx-padding: 10; -fx-background-radius: 5;">
         <children>
            <Label text="SIMULATION DATA" textFill="#c0392b">
               <font>
                  <Font name="System Bold" size="18.0" />
               </font>
            </Label>
            <Label text="This page is an educational simulation inspired by disaster-response challenges. The displayed values are fictional simulation data and do not represent official Nepal statistics or an actual deployment." textAlignment="CENTER" wrapText="true" />
         </children>
      </VBox>
      <GridPane hgap="20.0" vgap="20.0" VBox.vgrow="ALWAYS">
        <columnConstraints>
          <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
          <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
        </columnConstraints>
        <rowConstraints>
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
        </rowConstraints>
         <children>
            <VBox style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 5; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 5, 0, 0, 0);">
               <children>
                  <Label text="Zone A" textFill="#2980b9">
                     <font>
                        <Font name="System Bold" size="18.0" />
                     </font>
                  </Label>
                  <Label text="Simulation Scenario: Urban Flooding" textFill="#7f8c8d" />
                  <Label text="Simulated Impact: High" textFill="#e74c3c">
                     <VBox.margin>
                        <Insets top="10.0" />
                     </VBox.margin>
                  </Label>
                  <Label text="Simulated Action: 3 Rescue Teams deployed for swift-water evacuation." wrapText="true">
                     <VBox.margin>
                        <Insets top="10.0" />
                     </VBox.margin>
                  </Label>
               </children>
            </VBox>
            <VBox style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 5; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 5, 0, 0, 0);" GridPane.columnIndex="1">
               <children>
                  <Label text="Zone B" textFill="#2980b9">
                     <font>
                        <Font name="System Bold" size="18.0" />
                     </font>
                  </Label>
                  <Label text="Simulation Scenario: Landslide Blockage" textFill="#7f8c8d" />
                  <Label text="Simulated Impact: Critical" textFill="#e74c3c">
                     <VBox.margin>
                        <Insets top="10.0" />
                     </VBox.margin>
                  </Label>
                  <Label text="Simulated Action: Engineering team assigned to clear debris. Medical airlift requested." wrapText="true">
                     <VBox.margin>
                        <Insets top="10.0" />
                     </VBox.margin>
                  </Label>
               </children>
            </VBox>
            <VBox style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 5; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 5, 0, 0, 0);" GridPane.rowIndex="1">
               <children>
                  <Label text="Zone C" textFill="#2980b9">
                     <font>
                        <Font name="System Bold" size="18.0" />
                     </font>
                  </Label>
                  <Label text="Simulation Scenario: Stranded Village" textFill="#7f8c8d" />
                  <Label text="Simulated Impact: Medium" textFill="#f39c12">
                     <VBox.margin>
                        <Insets top="10.0" />
                     </VBox.margin>
                  </Label>
                  <Label text="Simulated Action: Resource airdrop in progress. 500 food rations allocated." wrapText="true">
                     <VBox.margin>
                        <Insets top="10.0" />
                     </VBox.margin>
                  </Label>
               </children>
            </VBox>
            <VBox style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 5; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 5, 0, 0, 0);" GridPane.columnIndex="1" GridPane.rowIndex="1">
               <children>
                  <Label text="Zone D" textFill="#2980b9">
                     <font>
                        <Font name="System Bold" size="18.0" />
                     </font>
                  </Label>
                  <Label text="Simulation Scenario: Evacuation Camp" textFill="#7f8c8d" />
                  <Label text="Simulated Impact: Low" textFill="#27ae60">
                     <VBox.margin>
                        <Insets top="10.0" />
                     </VBox.margin>
                  </Label>
                  <Label text="Simulated Action: Camp established safely. 200 simulation victims admitted to Shelter S-01." wrapText="true">
                     <VBox.margin>
                        <Insets top="10.0" />
                     </VBox.margin>
                  </Label>
               </children>
            </VBox>
         </children>
      </GridPane>
   </children>
</VBox>
